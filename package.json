{
  "name": "eatsave",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "check:auth": "node scripts/check-api-auth.mjs && node scripts/check-capture-script.mjs",
    "check:deploy": "node scripts/check-deploy-target.mjs",
    "check:safety": "node scripts/check-production-safety.mjs",
    "deploy": "node scripts/deploy-prod.mjs",
    "setup:check": "node -e \"fetch(process.env.NEXT_PUBLIC_APP_URL?process.env.NEXT_PUBLIC_APP_URL.replace(/\\\\/home$/,'')+'/api/setup':'http://localhost:3000/api/setup').then(r=>r.json()).then(j=>console.log(JSON.stringify(j,null,2))).catch(e=>console.error(e))\"",
    "promo:export": "node scripts/export-promo-video.mjs",
    "marketing:screenshots": "node scripts/capture-app-screenshots.mjs"
  },
  "overrides": {
    "postcss": "^8.5.19"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.108.0",
    "@tanstack/react-query": "^5.62.8",
    "@telegram-apps/sdk": "^2.11.3",
    "next": "15.5.18",
    "node-edge-tts": "^1.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.18",
    "playwright": "^1.61.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
